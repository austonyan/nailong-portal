      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">联系电话</span><input class=\"ds-input\" type=\"text\" placeholder=\"例：138 0000 0000\" /></label>",
      "css": ".ds-field{display:inline-flex;flex-direction:column;gap:8px;font-family:var(--animal-font-family,Nunito,\"Noto Sans SC\",sans-serif)}.ds-field-label{font-size:14px;font-weight:600;line-height:1.4;letter-spacing:.02em;color:var(--animal-text-color,#794f27)}.ds-input{height:48px;width:320px;max-width:100%;padding:0 22px;border:2px solid var(--animal-border-color,#dcd8d1);border-radius:50px;background:#fffdf7;color:var(--animal-text-color,#794f27);font-family:inherit;font-size:16px;font-weight:500;outline:none;transition:border-color .25s cubic-bezier(.4,0,.2,1)}.ds-input::placeholder{color:var(--animal-text-color-secondary,#9f927d)}.ds-input:hover{border-color:var(--animal-border-color-hover,#827157)}.ds-input:focus-visible{outline:2px solid var(--animal-text-color,#794f27);outline-offset:2px}"
    },
