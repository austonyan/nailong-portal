      "html": "<span class=\"ds-tag ds-tag-success\">已通过</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:999px;font-family:var(--animal-font-family,Nunito,\"Noto Sans SC\",sans-serif);font-size:12px;font-weight:600;line-height:1}.ds-tag-success{background:#e8f5e9;color:#2e7d32}.ds-tag-danger{background:#ffebee;color:#c62828}.ds-tag-warning{background:#fbe9e7;color:#bf360c}.ds-tag-info{background:#e6f0ff;color:#1565c0}"
    },
