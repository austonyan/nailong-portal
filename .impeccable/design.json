      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\">门户首页</a><a class=\"ds-nav-item active\" href=\"#\">签注申请署</a><a class=\"ds-nav-item\" href=\"#\">入境事务署</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:240px;padding:16px 12px;background:#f0e8d8;border-radius:18px;font-family:var(--animal-font-family,Nunito,\"Noto Sans SC\",sans-serif)}.ds-nav-item{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:999px;color:var(--animal-text-color-secondary,#9f927d);font-size:14px;font-weight:500;text-decoration:none;transition:color .15s cubic-bezier(.4,0,.2,1),background .15s cubic-bezier(.4,0,.2,1)}.ds-nav-item:hover{color:var(--animal-text-color,#794f27);background:#e6f9f6}.ds-nav-item.active{color:var(--animal-text-color,#794f27);background:#e6f9f6;font-weight:700;box-shadow:inset 3px 0 0 0 var(--animal-primary-color,#19c8b9)}.ds-nav-item:focus-visible{outline:2px solid var(--animal-text-color,#794f27);outline-offset:2px}"
    },
    {
