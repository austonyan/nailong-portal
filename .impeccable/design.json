      "css": ".ds-btn-default{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:45px;padding:0 20px;border:2px solid var(--animal-border-color,#dcd8d1);border-radius:50px;background:var(--animal-bg-color,#f8f8f0);color:var(--animal-text-color,#794f27);font-family:var(--animal-font-family,Nunito,\"Noto Sans SC\",sans-serif);font-size:14px;font-weight:600;letter-spacing:.02em;line-height:1;white-space:nowrap;cursor:pointer;box-shadow:0 2px 4px 0 rgba(61,52,40,.06);transition:all .25s cubic-bezier(.4,0,.2,1)}.ds-btn-default:hover{color:var(--animal-primary-color,#19c8b9);border-color:var(--animal-primary-color,#19c8b9);transform:translateY(-1px)}.ds-btn-default:active{transform:translateY(1px)}.ds-btn-default:focus-visible{outline:2px solid var(--animal-text-color,#794f27);outline-offset:2px}"
