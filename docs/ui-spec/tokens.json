{
  "$description": "奶龙统一门户 UI 设计 token。颜色/圆角/阴影/字体/动效映射自 animal-island-ui@2.3.0 运行时 :root；布局 token 为本项目补充。",
  "$extensions": {
    "com.nailong.spec": {
      "name": "Nailong UI Spec",
      "version": "1.1.0",
      "updated": "2026-10-29",
      "source": "node_modules/animal-island-ui/dist/index.css"
    }
  },

  "color": {
    "$type": "color",
    "$description": "语义色。成功/警告/错误是填充色，不是小号正文色。",
    "primary": {
      "$value": "#19c8b9",
      "$description": "品牌薄荷；装饰、选中底、图标点缀。对奶油底 1.97:1，不用于正文。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-primary-color" } }
    },
    "primary-hover": {
      "$value": "#3dd4c6",
      "$extensions": { "com.nailong.css": { "variable": "--animal-primary-color-hover" } }
    },
    "primary-active": {
      "$value": "#50b9ab",
      "$extensions": { "com.nailong.css": { "variable": "--animal-primary-color-active" } }
    },
    "primary-bg": {
      "$value": "#e6f9f6",
      "$extensions": { "com.nailong.css": { "variable": "--animal-primary-color-bg" } }
    },
    "success": {
      "$value": "#6fba2c",
      "$description": "成功填充/图标；小号正文仅 2.25:1。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-success-color" } }
    },
    "success-hover": {
      "$value": "#85cc45",
      "$extensions": { "com.nailong.css": { "variable": "--animal-success-color-hover" } }
    },
    "success-active": {
      "$value": "#5a9e1e",
      "$extensions": { "com.nailong.css": { "variable": "--animal-success-color-active" } }
    },
    "warning": {
      "$value": "#f5c31c",
      "$description": "警告填充/焦点黄；对奶油底 1.55:1，不用于文字。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-warning-color" } }
    },
    "warning-hover": {
      "$value": "#f7d04a",
      "$extensions": { "com.nailong.css": { "variable": "--animal-warning-color-hover" } }
    },
    "warning-active": {
      "$value": "#dba90e",
      "$extensions": { "com.nailong.css": { "variable": "--animal-warning-color-active" } }
    },
    "error": {
      "$value": "#e05a5a",
      "$description": "错误边框/危险按钮；小号正文仅 3.40:1。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-error-color" } }
    },
    "error-hover": {
      "$value": "#e87878",
      "$extensions": { "com.nailong.css": { "variable": "--animal-error-color-hover" } }
    },
    "error-active": {
      "$value": "#c94444",
      "$extensions": { "com.nailong.css": { "variable": "--animal-error-color-active" } }
    },
    "text": {
      "$value": "#794f27",
      "$description": "主文字；对 #f8f8f0 为 6.65:1。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-text-color" } }
    },
    "text-secondary": {
      "$value": "#9f927d",
      "$description": "2.86:1；只用于非关键/大号辅助文字。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-text-color-secondary" } }
    },
    "text-muted": {
      "$value": "#794f27",
      "$description": "运行时等于主文字，不产生更浅层级。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-text-color-muted" } }
    },
    "text-disabled": {
      "$value": "#c4b89e",
      "$extensions": { "com.nailong.css": { "variable": "--animal-text-color-disabled" } }
    },
    "bg": {
      "$value": "#f8f8f0",
      "$extensions": { "com.nailong.css": { "variable": "--animal-bg-color" } }
    },
    "bg-secondary": {
      "$value": "#f0e8d8",
      "$extensions": { "com.nailong.css": { "variable": "--animal-bg-color-secondary" } }
    },
    "bg-disabled": {
      "$value": "#f0ece2",
      "$extensions": { "com.nailong.css": { "variable": "--animal-bg-color-disabled" } }
    },
    "surface-card": {
      "$value": "#f7f3df",
      "$description": "Card / Modal / Table 内容面。",
      "$extensions": { "com.nailong.css": { "variable": null, "note": "由 Card 组件内置，无 :root 变量" } }
    },
    "surface-input": {
      "$value": "#fffdf7",
      "$description": "Input 内部；textarea 使用次级背景。",
      "$extensions": { "com.nailong.css": { "variable": null, "note": "由 Input 组件内置" } }
    },
    "border": {
      "$value": "#dcd8d1",
      "$description": "1.33:1；不能单独承担控件边界识别。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-border-color" } }
    },
    "border-hover": {
      "$value": "#827157",
      "$description": "4.42:1；需要可识别边界的自定义控件。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-border-color-hover" } }
    },
    "border-light": {
      "$value": "#e8e2d6",
      "$extensions": { "com.nailong.css": { "variable": "--animal-border-color-light" } }
    },
    "mask": {
      "$value": "rgba(0, 0, 0, 0.35)",
      "$extensions": { "com.nailong.css": { "variable": "--animal-mask-bg" } }
    },

    "tag-success-fg": { "$value": "#2e7d32", "$description": "Tag app-green soft 文字" },
    "tag-success-bg": { "$value": "#e8f5e9" },
    "tag-error-fg": { "$value": "#c62828", "$description": "Tag app-red soft 文字" },
    "tag-error-bg": { "$value": "#ffebee" },
    "tag-warning-fg": { "$value": "#bf360c", "$description": "Tag warm-peach-pink soft 文字" },
    "tag-warning-bg": { "$value": "#fbe9e7" },
    "tag-info-fg": { "$value": "#1565c0", "$description": "Tag app-blue soft 文字" },
    "tag-info-bg": { "$value": "#e6f0ff" },
    "tag-neutral-fg": { "$value": "#4e342e", "$description": "Tag brown soft 文字" },
    "tag-neutral-bg": { "$value": "#efebe9" },
    "tag-accent-fg": { "$value": "#00695c", "$description": "Tag app-teal soft 文字" },
    "tag-accent-bg": { "$value": "#e0f2f1" }
  },

  "space": {
    "$type": "dimension",
    "$description": "4px 步进；业务 CSS 只使用 1–8 档。",
    "1": { "$value": "4px", "$extensions": { "com.nailong.css": { "variable": "--animal-spacing-xs" } } },
    "2": { "$value": "8px", "$extensions": { "com.nailong.css": { "variable": "--animal-spacing-sm" } } },
    "3": { "$value": "12px", "$extensions": { "com.nailong.css": { "variable": "--animal-spacing-md" } } },
    "4": { "$value": "16px", "$extensions": { "com.nailong.css": { "variable": "--animal-spacing-lg" } } },
    "5": { "$value": "24px", "$extensions": { "com.nailong.css": { "variable": "--animal-spacing-xl" } } },
    "6": { "$value": "32px" },
    "7": { "$value": "40px" },
    "8": { "$value": "48px" }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "16px", "$extensions": { "com.nailong.css": { "variable": "--animal-border-radius-sm" } } },
    "base": { "$value": "18px", "$extensions": { "com.nailong.css": { "variable": "--animal-border-radius-base" } } },
    "lg": { "$value": "24px", "$extensions": { "com.nailong.css": { "variable": "--animal-border-radius-lg" } } },
    "card": { "$value": "20px", "$description": "Card 固定 20px，不来自 :root。" },
    "chip": { "$value": "12px", "$description": "小徽标/内嵌图标底；交互元素下限。" },
    "pill": { "$value": "50px", "$description": "按钮/输入框/Select 触发器。" },
    "full": { "$value": "999px", "$description": "头像/圆点/筛选 chip。" }
  },

  "borderWidth": {
    "$type": "dimension",
    "hairline": { "$value": "1px", "$description": "仅装饰分隔/表格虚线。" },
    "tag": { "$value": "1.5px" },
    "default": { "$value": "2px", "$extensions": { "com.nailong.css": { "variable": "--animal-border-width" } } },
    "strong": { "$value": "2.5px", "$description": "自定义 textarea/强调容器。" },
    "seal": { "$value": "3px", "$description": "奖章/票据外框。" }
  },

  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": { "color": "rgba(61, 52, 40, 0.06)", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px", "inset": false },
      "$description": "rgba(61,52,40,.06)；Toast/default 按钮。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-shadow-sm" } }
    },
    "base": {
      "$value": { "color": "rgba(61, 52, 40, 0.1)", "offsetX": "0px", "offsetY": "3px", "blur": "10px", "spread": "0px", "inset": false },
      "$description": "rgba(61,52,40,.1)；hover 高程。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-shadow-base" } }
    },
    "lg": {
      "$value": { "color": "rgba(61, 52, 40, 0.14)", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "inset": false },
      "$description": "rgba(61,52,40,.14)；大浮层。",
      "$extensions": { "com.nailong.css": { "variable": "--animal-shadow-lg" } }
    },
    "button-primary": {
      "$value": { "color": "#bdaea0", "offsetX": "0px", "offsetY": "5px", "blur": "0px", "spread": "0px", "inset": false },
      "$description": "仅 primary/danger-primary 按钮的 3D 厚阴影。",
      "$extensions": { "com.nailong.css": { "variable": null, "note": "Button 组件内置" } }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["Nunito", "Noto Sans SC", "-apple-system", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "sans-serif"],
      "$extensions": { "com.nailong.css": { "variable": "--animal-font-family" } }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "12px", "$extensions": { "com.nailong.css": { "variable": "--animal-font-size-sm" } } },
      "base": { "$value": "14px", "$extensions": { "com.nailong.css": { "variable": "--animal-font-size-base" } } },
      "lg": { "$value": "16px", "$extensions": { "com.nailong.css": { "variable": "--animal-font-size-lg" } } },
      "body-compact": { "$value": "13px" },
      "title": { "$value": "18px" },
      "section": { "$value": "20px" },
      "display": { "$value": "28px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400, "$description": "placeholder/说明；不得更低。" },
      "body": { "$value": 500 },
      "label": { "$value": 600 },
      "title": { "$value": 700 },
      "strong": { "$value": 800 },
      "ribbon": { "$value": 900, "$description": "Title 飘带/大字数字。" }
    },
    "lineHeight": {
      "$type": "number",
      "base": { "$value": 1.5715, "$extensions": { "com.nailong.css": { "variable": "--animal-line-height-base" } } },
      "body": { "$value": 1.6 },
      "compact": { "$value": 1.55 },
      "title": { "$value": 1.35 },
      "display": { "$value": 1.2 }
    }
  },

  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": ["Nunito", "Noto Sans SC", "sans-serif"],
        "fontSize": "14px",
        "fontWeight": 500,
        "lineHeight": 1.6,
        "letterSpacing": "0.01em"
      },
      "$description": "默认正文/表格/表单。"
    },
    "label": {
      "$value": {
        "fontFamily": ["Nunito", "Noto Sans SC", "sans-serif"],
        "fontSize": "14px",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0.02em"
      },
      "$description": "按钮/Tab/表单标签。"
    },
    "caption": {
      "$value": {
        "fontFamily": ["Nunito", "Noto Sans SC", "sans-serif"],
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": 1.5,
        "letterSpacing": "0.01em"
      },
      "$description": "时间/注释；屏幕 UI 最小字号。"
    },
    "page-title": {
      "$value": {
        "fontFamily": ["Nunito", "Noto Sans SC", "sans-serif"],
        "fontSize": "20px",
        "fontWeight": 700,
        "lineHeight": 1.35,
        "letterSpacing": "0.02em"
      },
      "$description": "每页唯一 h1；Title middle 也可承担视觉。"
    },
    "display": {
      "$value": {
        "fontFamily": ["Nunito", "Noto Sans SC", "sans-serif"],
        "fontSize": "28px",
        "fontWeight": 800,
        "lineHeight": 1.2,
        "letterSpacing": "0.01em"
      },
      "$description": "统计数字；配合 tabular-nums。"
    }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "0.15s", "$extensions": { "com.nailong.css": { "variable": "--animal-motion-duration-fast" } } },
      "base": { "$value": "0.25s", "$extensions": { "com.nailong.css": { "variable": "--animal-motion-duration-base" } } },
      "slow": { "$value": "0.35s", "$extensions": { "com.nailong.css": { "variable": "--animal-motion-duration-slow" } } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.4, 0, 0.2, 1],
        "$extensions": { "com.nailong.css": { "variable": "--animal-motion-ease" } }
      }
    }
  },

  "size": {
    "$type": "dimension",
    "control-sm": { "$value": "32px", "$extensions": { "com.nailong.css": { "variable": "--animal-height-sm" } } },
    "control-md": { "$value": "40px", "$extensions": { "com.nailong.css": { "variable": "--animal-height-base" } } },
    "control-lg": { "$value": "48px", "$extensions": { "com.nailong.css": { "variable": "--animal-height-lg" } } },
    "button-md": { "$value": "45px", "$description": "Button middle 实际高度。" },
    "touch-min": { "$value": "24px", "$description": "WCAG 2.2 最小目标；项目密集后台用 32px。" },
    "touch-comfortable": { "$value": "44px", "$description": "主操作/移动端建议。" }
  },

  "layout": {
    "$type": "dimension",
    "content-max": { "$value": "1440px", "$extensions": { "com.nailong.css": { "variable": "--nl-content-max" } } },
    "sider-width": { "$value": "260px", "$extensions": { "com.nailong.css": { "variable": "--nl-sider-width" } } },
    "page-pad": { "$value": "24px", "$extensions": { "com.nailong.css": { "variable": "--nl-page-pad" } } },
    "header-pad-mobile": { "$value": "16px", "$description": "≤640px 顶栏左右 padding；页面主 padding 仍为 24px。" },
    "auth-width": { "$value": "400px" },
    "setup-width": { "$value": "580px" },
    "dialog-sm": { "$value": "460px" },
    "dialog-md": { "$value": "560px" },
    "dialog-lg": { "$value": "640px" },
    "dialog-xl": { "$value": "720px" },
    "drawer-nav": { "$value": "280px" },
    "drawer-msg": { "$value": "440px" },
    "drawer-detail": { "$value": "560px" },
    "drawer-wide": { "$value": "640px" },
    "toast-max": { "$value": "560px" },
    "grid-card": { "$value": "240px" },
    "grid-stat": { "$value": "220px" },
    "grid-form": { "$value": "220px" },
    "field-label": { "$value": "110px" }
  },

  "focus": {
    "$type": "dimension",
    "$description": "键盘焦点尺寸；颜色见 01 Foundations §8.2（暖黄 + 深色内环兜底）。",
    "ring-width": { "$value": "2px", "$extensions": { "com.nailong.css": { "variable": "--nl-focus-ring" } } },
    "ring-offset": { "$value": "2px", "$extensions": { "com.nailong.css": { "variable": "--nl-focus-offset" } } },
    "scroll-margin": { "$value": "64px", "$description": "sticky 顶栏约 53px + 8px 呼吸。", "$extensions": { "com.nailong.css": { "variable": "--nl-focus-scroll-margin" } } }
  },

  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px", "$description": "手机：顶栏换行、顶栏 padding 16。" },
    "md": { "$value": "720px", "$description": "部分署内页/打印前收窄。" },
    "lg": { "$value": "900px", "$description": "复杂三栏/工作台收窄。" },
    "xl": { "$value": "1024px", "$description": "侧栏常驻下限；≤1024 收进抽屉。" },
    "content": { "$value": "1440px", "$description": "内容最大宽度。" },
    "min": { "$value": "360px", "$description": "最小验收宽度。" }
  }
}